diff --git a/app/services/llm.py b/app/services/llm.py
index 448f6e2..bd91dc4 100644
--- a/app/services/llm.py
+++ b/app/services/llm.py
@@ -6,17 +6,30 @@ from langchain_groq import ChatGroq
 from app.core.config import settings
 
 def get_llm():
-    """Returns the configured Mistral LLM instance."""
+    """Returns the configured Mistral LLM instance (vanilla constructor).
+
+    NOTE on rate limiting: the architect/repair loop can fire 5-10 calls
+    in a few seconds (RAG context + AST validation retries up to
+    MAX_RETRIES=8). On free / labs Mistral tiers this saturates TPM and
+    trips a 429 mid-pipeline. Retry wrapping is applied per-chain in
+    app/services/agents.py via Runnable.with_retry() AFTER any
+    .with_structured_output() composition (RunnableRetry has no
+    .with_structured_output method, so it must be applied last).
+    """
     api_key = os.getenv("MISTRAL_API_KEY")
     if not api_key:
         print("❌ CRITICAL ERROR: MISTRAL_API_KEY is missing from environment variables!")
         raise ValueError("MISTRAL_API_KEY is not set.")
-    
+
     return ChatMistralAI(
         model=settings.LLM_MODEL,
         api_key=api_key,
         temperature=0.2,
-        max_tokens=128000, 
+        # Was 128000 -- unrealistic for any Mistral model and some tiers
+        # reserve max_tokens upfront against TPM, causing immediate 429
+        # on free/labs accounts. 8k is more than enough for any
+        # Consultant/Architect output (typical AST < 4k tokens).
+        max_tokens=8000,
         top_p=0.9,
     )
 
