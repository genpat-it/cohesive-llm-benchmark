# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Editor / OS
.idea/
.vscode/
.DS_Store

# Local secrets - configure your LLM credentials OUTSIDE this repo
# (in your LLM server's own .env, never here)
.env
.env.*
!.env.example

# Eval runs land here -- commit only the reference examples
results/*/
!results/example_run_mistral/
!results/example_run_mistral_multi_turn/
!results/llm_full_200/
!results/llm_full_multi_turn/
!results/llm_full_200_mistral_small/
!results/llm_full_multi_turn_mistral_small/
!results/llm_full_200_devstral_2507/
!results/llm_full_multi_turn_devstral_2507/
!results/llm_full_200_devstral_labs/
!results/llm_full_multi_turn_devstral_labs/
!results/llm_multi_workflows/

# Harness scratch (work dirs, dummy inputs)
_scratch/
_out/
*.nextflow.log*
.nextflow/
work/

# Local snapshots of the Claude Code session JSONL (manual backups outside ~/.claude/)
.session-backup/
